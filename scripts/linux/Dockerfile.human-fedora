# Fedora 41 as a person has it, for the browser checks run elsewhere than
# Debian (DM_DISTRO=fedora in linux-chromium-human.sh and
# linux-firefox-check.sh). dm is not built here: it is built in the Debian
# image and copied in, as a person copies a binary or installs the .rpm.
# What is installed is what a Fedora user has or would add: the browser from
# Fedora's own repositories, the libraries the .rpm names
# (desktop/packaging/nfpm.yaml), Mesa for GL under Xvfb, and the test's own
# X server, window manager, xdotool and screenshots (ImageMagick).
FROM fedora:41
ARG BROWSER=chromium
RUN set -e; \
    case "$BROWSER" in \
      chromium) extra="chromium at-spi2-core python3-pyatspi" ;; \
      firefox) extra="firefox" ;; \
      *) echo "BROWSER is chromium or firefox"; exit 1 ;; \
    esac; \
    dnf install -y --setopt=install_weak_deps=False \
      xorg-x11-server-Xvfb openbox xdotool dbus-daemon python3 procps-ng glib2 ImageMagick \
      dejavu-sans-fonts libX11 libXcursor libX11-xcb libXi libxkbcommon libxkbcommon-x11 \
      libwayland-client libwayland-egl mesa-libEGL mesa-libGL mesa-dri-drivers \
      hicolor-icon-theme $extra; \
    dnf clean all
WORKDIR /work
