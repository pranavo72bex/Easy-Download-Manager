# Ubuntu 22.04 as a person has it, for the Firefox check run elsewhere than
# Debian (DM_DISTRO=ubuntu2204 in linux-firefox-check.sh). Ubuntu's own
# Firefox (and Chromium) is a snap, which needs snapd and so cannot run in
# a container: Firefox is Mozilla's tarball, which firefox-check.py fetches
# into the dm-firefox-cache volume, with the libraries Mozilla says it
# needs. dm is built in the Debian image and copied in; its libraries are
# the .deb's. Plus the test's X server, window manager, xdotool and ffmpeg
# for screenshots.
FROM ubuntu:22.04
ARG BROWSER=firefox
ENV DEBIAN_FRONTEND=noninteractive
RUN set -e; \
    [ "$BROWSER" = firefox ] || { echo "Ubuntu's Chromium is a snap: Firefox only"; exit 1; }; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      xvfb xauth openbox xdotool dbus python3 procps curl ca-certificates xz-utils bzip2 \
      ffmpeg fonts-dejavu-core \
      libgtk-3-0 libasound2 libdbus-glib-1-2 libx11-xcb1 libpci3 \
      libxkbcommon-x11-0 libegl1 libgl1 libgl1-mesa-dri \
      libx11-6 libxcursor1 libxi6 libxkbcommon0 libwayland-client0 libwayland-egl1; \
    rm -rf /var/lib/apt/lists/*
WORKDIR /work
