# Copy to .env (kept out of git) to choose the logins the tests use.
# Every one is optional: left out, each test makes up its own for the run.
# Read by crates/edm-test-support/src/secrets.rs.
EDM_TEST_PASSWORD=
EDM_TEST_PROXY=
EDM_TEST_SESSION=
EDM_TEST_OTHER=
EDM_TEST_TOKEN=
EDM_TEST_RTSP=
EDM_TEST_RTSP_USER=
