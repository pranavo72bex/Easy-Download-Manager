{
  "manifest_version": 3,
  "name": "dm — Download Manager",
  "version": "3.0.1",
  "description": "Catches downloads and offers \"Download video\" over players, handing them to the dm app, which does the downloading. With no app, the browser keeps them.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "storage",
    "webRequest"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pkg/dm_catcher.js",
        "pkg/dm_catcher_bg.wasm"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "dm",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
