+// dm(dwrite-rtl): whether the first strong letter of `text` is right to left (Hebrew, Arabic,
+// Syriac, Thaana, N'Ko, Samaritan, Mandaic and their presentation forms), the direction the
+// Unicode bidirectional algorithm gives a paragraph. A letter of any other script is left to
+// right; digits, spaces and punctuation are not strong.
+fn first_strong_is_rtl(text: &str) -> bool {
+    for character in text.chars() {
+        if character.is_alphabetic() {
+            return matches!(
+                character,
+                '\u{0590}'..='\u{08FF}' | '\u{FB1D}'..='\u{FDFF}' | '\u{FE70}'..='\u{FEFF}'
+            );
+        }
+    }
+    false
+}
+
+// dm(dwrite-rtl): a line with a right-to-left run laid out from DirectWrite's origins: each
+// left-to-right run moved from where upstream put it to its origin, every run then shifted so
+// the leftmost starts at 0, and the runs put in visual order.
+fn place_bidi_runs(runs: &mut Vec<ShapedRun>, places: &[RunPlace]) {
+    let left = |place: &RunPlace| {
+        if place.rtl {
+            place.origin_x - place.advance
+        } else {
+            place.origin_x
+        }
+    };
+    let leftmost = places.iter().map(left).fold(f32::INFINITY, f32::min);
+    if !leftmost.is_finite() {
+        return;
+    }
+    let mut keyed = Vec::with_capacity(runs.len());
+    for (index, mut run) in std::mem::take(runs).into_iter().enumerate() {
+        let key = match places.iter().find(|place| place.run == index) {
+            Some(place) => {
+                let shift = if place.rtl {
+                    -leftmost
+                } else {
+                    place.origin_x - place.start - leftmost
+                };
+                for glyph in &mut run.glyphs {
+                    glyph.position.x += px(shift);
+                }
+                left(place) - leftmost
+            }
+            None => run
+                .glyphs
+                .first()
+                .map_or(0.0, |glyph| glyph.position.x.as_f32()),
+        };
+        keyed.push((key, run));
+    }
+    keyed.sort_by(|(a, _), (b, _)| a.total_cmp(b));
+    runs.extend(keyed.into_iter().map(|(_, run)| run));
+}
