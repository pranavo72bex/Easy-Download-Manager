# Text files keep \n line endings on every checkout, Windows included: the
# generated documents (docs/scorecard.md) are compared
# byte for byte with what the code generates, and a CRLF checkout made the
# Windows CI job fail that comparison.
* text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.wasm binary
*.7z binary
*.lzma binary
*.lzma2 binary
*.jar binary
# cmd.exe misreads a batch file's labels with \n alone (the Gradle wrapper's gradlew.bat).
*.bat text eol=crlf
