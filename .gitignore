dist/
target/
# edm-core's FTP `target` module's own folder (its tests), not a build's.
!crates/edm-core/src/ftp/target/
pkg/
__pycache__/
.DS_Store
# Claude Code's own files stay local; its project skills are shared.
.claude/*
!.claude/skills/
human-shots/

# Local test logins and secrets (crates/edm-test-support/src/secrets.rs); never pushed.
.env
.env.*
!.env.example

# Internal QA notes and screenshots, kept on the tester's computer; the
# Docker QA suite itself (qa/run.sh and what it builds) is in the repository.
qa/*
!qa/.gitignore
!qa/docker-compose.yml
!qa/run.sh
!qa/app/
!qa/lib/
!qa/origin/
!qa/mockvideo/
!qa/tests/
**/__pycache__/
dist.new/
dist.old/

# Editors and systems
Thumbs.db
*.swp
.vscode/
.idea/

# What `make build` made
/build/
engine/

# Local-only engine requirements (never committed)
docs/engine-local/

# Graphify knowledge graph (local analysis only)
graphify-out/

# The benchmark: reference A named only here; results are per machine
bench/local.json
bench/results/

# A test run inside a vendored crate (vendor/README.md) makes a lock
# file of its own there; EDM's build uses Cargo.lock.
vendor/librqbit/Cargo.lock
vendor/librqbit-sha1-wrapper/Cargo.lock

# cargo fuzz's working folders (gaps row H11): the corpus it grows and what it found; a crash
# found is kept as a test where it is fixed.
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
