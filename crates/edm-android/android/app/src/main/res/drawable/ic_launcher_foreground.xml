<!-- EDM's launcher icon: a solid arrow over a file in three parts, the last still coming, the
     drawing of assets/app-icons/icon.svg (the one source of EDM's icons, desktop and extension
     too) in the same units, inside the adaptive icon's safe circle (the middle 66 of 108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The arrow's shaft. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50,30 H58 A3,3 0 0 1 61,33 V52 H47 V33 A3,3 0 0 1 50,30 Z" />
    <!-- The arrow's head, its corners rounded by its outline. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:pathData="M37,49 H71 L54,66 Z" />
    <!-- The two parts that have come. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39,71 H44 A3,3 0 0 1 44,77 H39 A3,3 0 0 1 39,71 Z M51.5,71 H56.5 A3,3 0 0 1 56.5,77 H51.5 A3,3 0 0 1 51.5,71 Z" />
    <!-- The part still coming. -->
    <path
        android:fillColor="#73FFFFFF"
        android:pathData="M64,71 H69 A3,3 0 0 1 69,77 H64 A3,3 0 0 1 64,71 Z" />
</vector>
