<!-- EDM's launcher icon: a white arrow over a download's progress bar, the drawing of
     assets/app-icons/icon.svg (the one source of EDM's icons, desktop and extension too) in
     the same units, inside the adaptive icon's safe circle (the middle 66 of 108). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The arrow's shaft and head. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,30 V55 M42,43.5 L54,55.5 L66,43.5" />
    <!-- The progress bar's track. -->
    <path
        android:fillColor="#59FFFFFF"
        android:pathData="M38,66 H70 A4,4 0 0 1 70,74 H38 A4,4 0 0 1 38,66 Z" />
    <!-- What has come. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,66 H57 A4,4 0 0 1 57,74 H38 A4,4 0 0 1 38,66 Z" />
</vector>
