<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- EDM's Safari extension's program (crates/edm-safari), signed with these by
     scripts/safari-extension.sh. macOS runs an extension only in a sandbox, and the EDM host it
     starts for each message runs in that sandbox too, so the sandbox lets it do what the host
     does for Chrome and Firefox: read and write EDM's own folder (the settings, the inbox the
     running EDM reads, the instance lock), and ask a server once before a download is taken
     and ring the running EDM on this computer's loopback (network.client). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/edm-engine/</string>
	</array>
</dict>
</plist>
